<?xml version="1.0" encoding="utf-8" ?>
<Feature SiLA2Version="1.0" FeatureVersion="1.0"
         Originator="io.epsilan" Category="sensors"
         xmlns="http://www.sila-standard.org"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
  <Identifier>Gyroscope</Identifier>
  <DisplayName>CoreS3 Gyroscope</DisplayName>
  <Description>Reports the current three-axis angular rate from the onboard BMI270.</Description>
  <Property>
    <Identifier>AngularRate</Identifier>
    <DisplayName>Angular Rate</DisplayName>
    <Description>Current X, Y, and Z angular rate in degrees per second.</Description>
    <Observable>Yes</Observable>
    <DataType>
      <Structure>
        <Element><Identifier>X</Identifier><DisplayName>X Angular Rate</DisplayName><Description>Angular rate around the X axis.</Description><DataType><Basic>Real</Basic></DataType></Element>
        <Element><Identifier>Y</Identifier><DisplayName>Y Angular Rate</DisplayName><Description>Angular rate around the Y axis.</Description><DataType><Basic>Real</Basic></DataType></Element>
        <Element><Identifier>Z</Identifier><DisplayName>Z Angular Rate</DisplayName><Description>Angular rate around the Z axis.</Description><DataType><Basic>Real</Basic></DataType></Element>
      </Structure>
    </DataType>
  </Property>
</Feature>
